{
  "name": "brightloop-server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "LOG_REQUESTS=off node --test --test-concurrency=1 test/*.test.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "seed": "node --env-file-if-exists=.env src/db/seed.js",
    "db:reset": "dropdb --if-exists subscriptions && createdb subscriptions && node src/db/seed.js",
    "loadtest": "node scripts/loadtest.mjs",
    "migrate:status": "node --env-file-if-exists=.env src/db/migrate.js status",
    "migrate:create": "node src/db/migrate.js create"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "express": "^5.3.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1"
  }
}
