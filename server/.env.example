PORT=4000
DATABASE_URL=postgres://localhost:5432/subscriptions
APP_URL=http://localhost:5173
SESSION_DAYS=7

# Leave SMTP_HOST empty to print emails (reset links, invoices) to the server console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Brightloop Billing <billing@brightloop.io>

# Razorpay test keys (Dashboard > Settings > API Keys). Leave empty to hide online payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
